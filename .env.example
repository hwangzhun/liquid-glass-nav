# Personal login password (server-side only). Vite uses "tidal" only when this is omitted locally.
NAV_PASSWORD=replace-with-your-password

# Allow proxy/TUN fake DNS addresses in 198.18.0.0/15 for the Node server.
# Vite development mode enables this automatically. Keep disabled on public servers.
ALLOW_PROXY_FAKE_IPS=false

# OpenAI-compatible AI service (server-side only; never expose the key to VITE_* variables)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
